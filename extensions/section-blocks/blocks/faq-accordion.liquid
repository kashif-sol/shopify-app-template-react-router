{%- assign ent = app.metafields.section_app.entitlements.value -%}
{%- assign tier = 'pro' -%}
{%- if tier == 'free' or ent.all == true or ent.sections contains 'faq-accordion' -%}
  {%- render 'faq-accordion-markup', block: block -%}
{%- elsif request.design_mode -%}
  <div class="sa-locked">🔒 Unlock “FAQ Accordion” in Section App</div>
{%- endif -%}

{% schema %}
{
  "name": "FAQ Accordion",
  "target": "section",
  "stylesheet": "section-app.css",
  "javascript": "section-app.js",
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Layout",
      "options": [
        { "value": "single", "label": "Single column" },
        { "value": "two-col", "label": "Two columns" }
      ],
      "default": "single"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "q_1",
      "label": "Question 1",
      "default": "How fast do you ship?"
    },
    {
      "type": "textarea",
      "id": "a_1",
      "label": "Answer 1",
      "default": "Orders ship within 1–2 business days with tracking included."
    },
    {
      "type": "text",
      "id": "q_2",
      "label": "Question 2",
      "default": "What is your return policy?"
    },
    {
      "type": "textarea",
      "id": "a_2",
      "label": "Answer 2",
      "default": "We offer a 30-day hassle-free return policy on all unused items."
    },
    {
      "type": "text",
      "id": "q_3",
      "label": "Question 3",
      "default": "Do you ship internationally?"
    },
    {
      "type": "textarea",
      "id": "a_3",
      "label": "Answer 3",
      "default": "Yes, we ship worldwide with duties calculated at checkout."
    },
    {
      "type": "text",
      "id": "q_4",
      "label": "Question 4",
      "default": "How can I contact support?"
    },
    {
      "type": "textarea",
      "id": "a_4",
      "label": "Answer 4",
      "default": "Reach out anytime through our contact page and we reply within 24 hours."
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "options": [
        { "value": "all", "label": "All" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" }
      ],
      "default": "all"
    }
  ]
}
{% endschema %}
